    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "typescript": "^5",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24 <25"
