# Local photo preparation and incomplete reports run without credentials.
# Fill these only in an ignored .env.local after provider access is arranged.
# Both credentials must remain on the server.
GEMINI_API_KEY=
SESSION_SIGNING_SECRET=
GEMINI_MODEL=gemini-3.8-flash
SCREENING_ENABLED=false
# demo permits only sample data. paid requires an actually paid Gemini service.
GEMINI_SERVICE_TIER=demo
# Enable only behind the trusted Google Cloud Run ingress, after header verification.
TRUST_PROXY=false
NEXT_TELEMETRY_DISABLED=1
